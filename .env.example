# Copy this file to .env for local development. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
# Set to True only when your proxy/host serves HTTPS.
SECURE_SSL_REDIRECT=False
# Where uploaded product images are kept.
#   database   = (default) stored in the database, so they survive redeploys on
#                hosts with an ephemeral filesystem such as Render or Railway.
#   filesystem = classic MEDIA_ROOT; only use it with a real persistent disk.
MEDIA_STORAGE=database
# Optional: only needed with MEDIA_STORAGE=filesystem and a mounted disk.
# MEDIA_ROOT=/data/media
# Set False only if a CDN or object store answers /media/ instead of Django.
SERVE_MEDIA=True
# Browser cache lifetime for uploaded images (seconds); ETags handle updates.
MEDIA_CACHE_SECONDS=3600
# Largest product image an admin may upload, in megabytes.
MAX_IMAGE_UPLOAD_MB=5

# Brevo SMTP Email Configuration (Free 300 emails/day forever)
# Get credentials from: Brevo Dashboard -> SMTP & API -> SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-smtp-login@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-master-key
DEFAULT_FROM_EMAIL=Northstar Store <your-verified-sender@example.com>
BREVO_API_KEY=your-brevo-api-key
OTP_EXPIRY_MINUTES=5

