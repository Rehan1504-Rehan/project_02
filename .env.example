# Copy this file to .env for local development. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
# Set to True only when your proxy/host serves HTTPS.
SECURE_SSL_REDIRECT=False
# Media is served automatically by Django (default: True). Set True for persistent disk/volume.
SERVE_MEDIA=True
